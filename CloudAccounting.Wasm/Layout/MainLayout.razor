@inherits LayoutComponentBase

@using Blazored.LocalStorage
@using CloudAccounting.Wasm.Components
@using CloudAccounting.Wasm.Pages
@using CloudAccounting.Wasm.Authentication
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => _drawerOpen = !_drawerOpen)" />
            <RadzenLabel Text="Cloud Accounting" />
            <RadzenStack Orientation="Orientation.Horizontal" Style="margin-left: auto;">
                <AuthorizeView>
                    <Authorized>
                        @if (_showLogoutButton)
                        {
                            <LogoutButton Name="@_userEmail" OnLogout="OnLogout" />                                          
                        }
                    </Authorized>
                    <NotAuthorized>
                        <RadzenText class="rz-mr-3" TextStyle="TextStyle.Subtitle2">Please log in.</RadzenText>
                    </NotAuthorized>
                </AuthorizeView>                
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="_drawerOpen" Style="width:300px">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home" Icon="home" Path="/" />

            <RadzenPanelMenuItem Text="Setup" Icon="build">
                <RadzenPanelMenuItem Text="Company" Icon="corporate_fare" Path="/Pages/Company/CompaniesListPage" />
                <RadzenPanelMenuItem Text="Fiscal Year" Icon="date_range" Path="/Pages/FiscalYear/FiscalYearSetupPage" />
                <RadzenPanelMenuItem Text="Voucher Types" Icon="local_activity" Path="/Pages/VoucherTypes/VoucherTypesListPage" />
            </RadzenPanelMenuItem>
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

<RadzenComponents />


@code {
    bool _drawerOpen = true;
    private bool _showLogoutButton;
    private string _userEmail = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await ((CustomAuthStateProvider)AuthStateProvider).GetAuthenticationStateAsync();
            var user = authState.User;

            if (!user.Identity!.IsAuthenticated)
            {
                _showLogoutButton = false;
                Navigation.NavigateTo("/login");
            }
            else
            {
                var claim = user.Claims.Where(c => c.Type == "email").SingleOrDefault();
                _userEmail = claim!.Value;
                _showLogoutButton = true;
            }
        }
        catch (Exception)
        {        
            Navigation.NavigateTo("/login", true);
        }
    }

    private async Task OnLogout()
    {
        await ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsLoggedOut();
        Http.DefaultRequestHeaders.Authorization = null;

        _showLogoutButton = false;

        Navigation.NavigateTo("/login");
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
