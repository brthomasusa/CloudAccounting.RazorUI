@inherits LayoutComponentBase

@implements IDisposable

@using CloudAccounting.Wasm.Components
@using CloudAccounting.Wasm.Pages
@using CloudAccounting.Wasm.Authentication
@using CloudAccounting.Wasm.Services.ApplicationState

@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => _drawerOpen = !_drawerOpen)" />
            <RadzenLabel Text="Cloud Accounting" />
            <RadzenStack Orientation="Orientation.Horizontal" Style="margin-left: auto;">
                <AuthorizeView>
                    <Authorized>
                        <CompanyFiscalYearIndicator CompanyName="@AuthenticatedUserState!.GetCompanyName()"
                                                    CompanyMonthName="@AuthenticatedUserState!.GetCompanyMonthName()"
                                                    CurrentFiscalYear="@AuthenticatedUserState!.GetCompanyYear()" />

                        @if (@AuthenticatedUserState!.GetUser() != null)
                        {
                            <LogoutButton Name="@AuthenticatedUserState!.GetUser().UserId" />
                        }
                    </Authorized>
                    <NotAuthorized>
                        <RadzenText class="rz-mr-4" TextStyle="TextStyle.Subtitle2">Please log in.</RadzenText>
                    </NotAuthorized>
                </AuthorizeView>
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="_drawerOpen" Style="width:300px">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home" Icon="home" Path="/" />

            <RadzenPanelMenuItem Text="Setup" Icon="build">
                <AuthorizeView Roles="CompanyAdmin">
                    <Authorized>
                        <RadzenPanelMenuItem Text="Company" Icon="corporate_fare"
                                             Path="/Pages/Company/CompaniesListPage" />
                        <RadzenPanelMenuItem Text="Fiscal Year" Icon="date_range"
                                             Path="/Pages/FiscalYear/FiscalYearSetupPage" />
                        <RadzenPanelMenuItem Text="Voucher Types" Icon="local_activity"
                                             Path="/Pages/VoucherTypes/VoucherTypesListPage" />
                        <RadzenPanelMenuItem Text="Roles & Users" Icon="people" Path="/Pages/Users/UsersListPage" />
                    </Authorized>
                </AuthorizeView>
            </RadzenPanelMenuItem>
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

<RadzenComponents />


@code {
    bool _drawerOpen = true;

    [Inject] private IAuthenticatedUserState? AuthenticatedUserState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticatedUserState!.OnChange += StateHasChanged;

            var authState = await ((CustomAuthStateProvider)AuthStateProvider).GetAuthenticationStateAsync();
            var user = authState.User;

            if (!user.Identity!.IsAuthenticated)
            {
                Navigation.NavigateTo("/login");
            }
        }
        catch (Exception)
        {
            Navigation.NavigateTo("/login", true);
        }
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose()
    {
        AuthenticatedUserState!.OnChange -= StateHasChanged;
    }
}
