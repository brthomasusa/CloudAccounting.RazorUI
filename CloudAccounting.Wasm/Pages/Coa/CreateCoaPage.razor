
@page "/Pages/Coa/CoaCreatePage/{companyCode:int}"
@using CloudAccounting.Wasm.Components
@using CloudAccounting.Wasm.Models.Coa

<PageTitle>Create General Ledger Account</PageTitle>

<RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween"
             Style="height: 100%;">
    <RadzenText TextStyle="TextStyle.Subtitle1">Create GL Account</RadzenText>
    <RadzenRow>
        <RadzenColumn Size="12" class="rz-p-4 rz-border-radius-1" Style="border: var(--rz-grid-cell-border)">
            @if (_coaCommand is null)
            {
                <LoadingIndicator />
            }
            else
            {
                <NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation"
                                ConfirmExternalNavigation="_hasUnsavedChanges" />

                <RadzenTemplateForm TItem="CreateChartOfAccountCommand" Data="@_coaCommand"
                                    Submit="@(async args => { await Submit(args); })">
                    <RadzenRow Gap="2rem" class="rz-p-0 rz-p-lg-4">
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenStack Gap="1rem">

                                <RadzenStack Orientation="Orientation.Horizontal">
                                    <RadzenLabel Style="width: 150px;" Component="classificationDropDown">
                                        <span style="color: red;">*</span> Classification
                                    </RadzenLabel>
                                    @if (_generalLedgerAccountTypes is not null)
                                    {
                                        <RadzenDropDown @bind-Value=@_coaCommand.LevelOne
                                                        Data=@_generalLedgerAccountTypes
                                                        TValue="string"
                                                        TextProperty="@nameof(GeneralLedgerAccountType.Name)"
                                                        ValueProperty="@nameof(GeneralLedgerAccountType.Classification)"
                                                        Style="width: 100%; max-width: 500px"
                                                        Placeholder="Select..."
                                                        Name="classificationDropDown" />
                                    }
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="levelTwoInput">
                                        Level Two
                                    </RadzenLabel>

                                    <RadzenTextBox Name="levelTwoInput" @bind-Value=@_coaCommand.LevelTwo
                                                   Placeholder="Enter 2nd level of account code" @oninput="@(e => _hasUnsavedChanges = true)" />
                                    <RadzenRegexValidator Component="levelTwoInput" Text="Level two must be 2 digits (01 - 99)" Pattern="\d{2}" Popup=true Style="position: absolute" />
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="levelThreeInput">
                                        Level Three
                                    </RadzenLabel>

                                    <RadzenTextBox Name="levelThreeInput" @bind-Value=@_coaCommand.LevelThree
                                                   Placeholder="Enter 3rd level of account code" @oninput="@(e => _hasUnsavedChanges = true)" />
                                    <RadzenRegexValidator Component="levelThreeInput" Text="Level three must be 3 digits (001 - 999)" Pattern="\d{3}" Popup=true Style="position: absolute" />
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="levelFourInput">
                                        Level Four
                                    </RadzenLabel>

                                    <RadzenTextBox Name="levelFourInput" @bind-Value=@_coaCommand.LevelFour
                                                   Placeholder="Enter 4th level of account code" @oninput="@(e => _hasUnsavedChanges = true)" />
                                    <RadzenRegexValidator Component="levelFourInput" Text="Level four must be 5 digits (00001 - 99999)" Pattern="\d{5}" Popup=true Style="position: absolute" />
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="acctTitleInput">
                                        Title <span style="color: var(--rz-danger);">*</span>
                                    </RadzenLabel>

                                    <RadzenTextBox Name="acctTitleInput" @bind-Value=@_coaCommand.AccountTitle
                                                   Placeholder="Enter account title" @oninput="@(e => _hasUnsavedChanges = true)" />
                                    <RadzenRequiredValidator Component="acctTitleInput" Text="Missing account title"
                                                             Popup="true" Style="position: absolute" />
                                    <RadzenLengthValidator Component="acctTitleInput" Max="50"
                                                           Text="Account title cannot exceed 50 characters" Popup=true
                                                           Style="position: absolute" />
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenLabel Component="acctTypeInput">
                                        Type <span style="color: var(--rz-danger);">*</span>
                                    </RadzenLabel>

                                    <RadzenTextBox Name="acctTypeInput" @bind-Value=@_coaCommand.AccountType
                                                   Placeholder="Enter account type" @oninput="@(e => _hasUnsavedChanges = true)" />

                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Horizontal">
                                    <RadzenLabel Style="width: 150px;" Component="costCenterDropDown">
                                        <span style="color: red;">*</span> Cost Center
                                    </RadzenLabel>
                                    @if (_costCenterLookupItems is not null)
                                    {
                                        <RadzenDropDown @bind-Value=@_coaCommand.CostCenterCode
                                        Data=@_costCenterLookupItems
                                        TValue="string"
                                        TextProperty="@nameof(CostCenterLookupItem.CostCenterTitle)"
                                        ValueProperty="@nameof(CostCenterLookupItem.CostCenterCode)"
                                        Style="width: 100%; max-width: 500px"
                                        Placeholder="Select..."
                                        Name="costCenterDropDown" />
                                        <RadzenCustomValidator Component="costCenterDropDown"
                                        Validator="@(() => ValidateCostCenter(_coaCommand.CostCenterCode))"
                                        Text="Please select classification."
                                        Popup="true" />
                                    }
                                </RadzenStack>

                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="6" class="rz-text-align-start">
                            <RadzenButton class="rz-mr-4" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                          Size="ButtonSize.Medium" Icon="cancel" Text="Cancel" Click="@Cancel" />
                        </RadzenColumn>
                        <RadzenColumn Size="6" class="rz-text-align-end">
                            <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success"
                                          Size="ButtonSize.Medium" Icon="save" Text="Save" />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenTemplateForm>
            }
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>