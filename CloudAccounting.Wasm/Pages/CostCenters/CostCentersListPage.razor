@page "/Pages/CostCenters/CostCentersListPage"
@using CloudAccounting.Wasm.Components
@using CloudAccounting.Wasm.Models.CostCenters

<PageTitle>Cost Centers</PageTitle>

<RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween"
             Style="height: 100%;">
    <RadzenRow>
        <RadzenColumn Size="12" class="rz-p-4 rz-border-radius-1" Style="border: var(--rz-grid-cell-border)">
            @if (_costCenters is null || !_costCenters.Any())
            {
                <LoadingIndicator />
            }
            else
            {
                <ErrorBoundary>
                    <ChildContent>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="6">
                                <RadzenText TextStyle="TextStyle.Subtitle1">Manage Cost Centers</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="6" class="rz-text-align-right">
                                <RadzenButton Click="GoToCreateCostCenterPage" Icon="add_circle"
                                              Size="ButtonSize.Medium" class="rz-border-radius-10 rz-shadow-6 rz-mb-4"
                                              ButtonStyle="ButtonStyle.Info" title="Create Cost Center" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenDataGrid TItem="CostCenterDto" Data="@(_costCenters)" IsLoading="@isLoading"
                                        LoadData="@GetCostCenters" Count="@(_costCenters!.Count)" AllowFiltering="true"
                                        FilterMode="FilterMode.Simple" AllowPaging="true" AllowSorting="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Density="Density.Compact"
                                        AllowAlternatingRows="true" PageSize="20" PageSizeText="Rows per page" ShowPagingSummary="true"
                                        PagerHorizontalAlign="HorizontalAlign.Center" GridLines="DataGridGridLines.Horizontal">
                            <Columns>
                                <RadzenDataGridColumn TItem="CostCenterDto" Property="CostCenterCode" Title="Code"
                                                      Filterable="false" Width="100px" />
                                <RadzenDataGridColumn TItem="CostCenterDto" Property="CostCenterTitle" Title="Title"
                                                      Filterable="false" Width="100px" />
                                <RadzenDataGridColumn TItem="CostCenterDto" Property="CostCenterLevel" Title="Level"
                                                      Filterable="false" Width="100px" />

                                <RadzenDataGridColumn TItem="CostCenterDto" Sortable="false" Filterable="false"
                                                      Width="20px">
                                    <Template Context="item">
                                        <RadzenButton Click="() => ViewCostCenterDetails(item)" Icon="edit_square"
                                                      Size="ButtonSize.ExtraSmall" class="rz-border-radius-10 rz-shadow-6"
                                                      ButtonStyle="ButtonStyle.Info" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <!-- Fallback UI when an error occurs -->
                        <p class="errorUI">An error has occurred: @ex.Message</p>
                    </ErrorContent>
                </ErrorBoundary>
            }
        </RadzenColumn>
    </RadzenRow>
    <RadzenAlert Visible="@_showErrorAlert" Title="@_errorAlertTitle" AlertStyle="AlertStyle.Danger"
                 Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="true" Close="@OnAlertClose">
        @_errorAlertMessage
    </RadzenAlert>
</RadzenStack>