@page "/Pages/FiscalYear/FiscalYearSetupPage"
@using CloudAccounting.Wasm.Components
@using Radzen

<PageTitle>Fiscal Year Setup</PageTitle>

<RadzenText TextStyle="TextStyle.Subtitle1">Create and View company fiscal year information</RadzenText>

<ErrorBoundary>
    <ChildContent>
        <RadzenCard Variant="Variant.Outlined" class="rz-p-0 rz-m-0">
            <RadzenTemplateForm @key="@_fiscalYearCommand" Data="@_fiscalYearCommand" Submit="@(async (CreateFiscalYearCommand args) => { await Submit(args); })">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rz-p-sm-12">
                                <RadzenLabel Style="width: 150px;" Component="companyDropDown">
                                    <span style="color: red;">*</span> Companies
                                </RadzenLabel>
                                @if (_companyLookups is not null)
                                {
                                    <RadzenDropDown @bind-Value=@_fiscalYearCommand.CompanyCode
                                                    Data=@_companyLookups
                                                    TValue="int"
                                                    Change="@(args => OnCompanyDropDownChanged(args))"
                                                    TextProperty="@nameof(CompanyLookup.CompanyName)"
                                                    ValueProperty="@nameof(CompanyLookup.CompanyCode)"
                                                    Style="width: 100%; max-width: 500px"
                                                    Name="companyDropDown" />
                                    <RadzenCustomValidator 
                                        Component="companyDropDown" 
                                        Validator="@(() => ValidateCompanyCode(_fiscalYearCommand.CompanyCode))"
                                        Text="Please select company." 
                                        Popup="true" />
                                }
                            </RadzenStack>
                        </div>
                        <div class="col">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenLabel class="rz-m-0" TextStyle="TextStyle.Subtitle2" Style="width: 150px;" Component="fiscalYearInput">
                                    <span style="color: red;">*</span> Fiscal Year
                                </RadzenLabel>
                                <RadzenNumeric Name="fiscalYearInput"
                                               @bind-Value=@_fiscalYearCommand.FiscalYear
                                               Placeholder="Enter fiscal year" />
                                <RadzenCustomValidator 
                                    Component="fiscalYearInput" 
                                                       Validator="@(() => ValidateFiscalYearWhenPreviousFiscalYear(_fiscalYearCommand.FiscalYear))"
                                    Text="Fiscal year can not start before last day of previous fiscal year or after a year from today." 
                                    Popup="true" />
                                <RadzenCustomValidator Component="fiscalYearInput"
                                                       Validator="@(() => ValidateFiscalYearWhenNoPreviousFiscalYear(_fiscalYearCommand.FiscalYear))"
                                                       Text="Fiscal year can not start before 2000 or after a year from today."
                                                       Popup="true" />
                            </RadzenStack>
                        </div>
                        <div class="col">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rz-p-sm-12">
                                <RadzenLabel Style="width: 150px;" Component="monthDropDown">
                                    <span style="color: red;">*</span> Start Month
                                </RadzenLabel>
                                @if (_months is not null)
                                {
                                    <RadzenDropDown @bind-Value=@_fiscalYearCommand.StartMonthNumber
                                                    Data=@_months
                                                    TextProperty="@nameof(MonthLookup.MonthName)"
                                                    ValueProperty="@nameof(MonthLookup.MonthId)"
                                                    Style="width: 100%; max-width: 400px;"
                                                    Name="monthDropDown" />
                                    <RadzenCustomValidator 
                                        Component="monthDropDown" 
                                        Validator="@(() => ValidateStartMonth(_fiscalYearCommand.StartMonthNumber))" 
                                        Text="Select fiscal year start month." 
                                        Popup="true" />
                                }
                            </RadzenStack>
                        </div>
                        <div class="col">
                            <RadzenButton ButtonType="ButtonType.Submit" Size="ButtonSize.Medium" Icon="save" Text="Generate Fiscal Year" />
                        </div>
                    </div>
                </div>
            </RadzenTemplateForm>
        </RadzenCard>

        <RadzenCard Variant="Variant.Outlined" class="rz-p-0 rz-m-0 rz-mt-7">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenLabel class="rz-m-0" Text="Company Name" TextStyle="TextStyle.Subtitle2" Style="width: 150px;" Component="companyNameInput" />
                            <RadzenTextBox Name="companyNameInput" @bind-Value=@_companyWithFiscalPeriods.CompanyName ReadOnly />
                        </RadzenStack>
                    </div>
                    <div class="col">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenLabel class="rz-m-0" Text="Fiscal Year" TextStyle="TextStyle.Subtitle2" Style="width: 150px;" Component="fiscalYearInput" />
                            <RadzenNumeric Name="fiscalYearInput" @bind-Value=@_companyWithFiscalPeriods.FiscalYear ReadOnly />
                        </RadzenStack>
                    </div>
                    <div class="col">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenCheckBox @bind-Value=@_companyWithFiscalPeriods.IsInitialYear Name="isInitYearCheckBox" ReadOnly />
                            <RadzenLabel Text="Initial Year?" Component="isInitYearCheckBox" />
                        </RadzenStack>
                    </div>
                </div>
                <hr />
                <div class="row mt-5">
                    <div class="col">
                        @if (_companyWithFiscalPeriods is null)
                        {
                            <LoadingIndicator />
                        }
                        else
                        {
                            <ErrorBoundary>
                                <ChildContent>
                                    <RadzenDataGrid TItem="FiscalPeriodDto" 
                                        Data="@(_companyWithFiscalPeriods.FiscalPeriods)" 
                                        IsLoading="@isLoading"
                                        LoadData="@GetFiscalPeriods" 
                                        Count="@(_companyWithFiscalPeriods.FiscalPeriods!.Count)"
                                        Density="Density.Compact" 
                                        AllowAlternatingRows="true">                                                    
                                                    
                                        <Columns>
                                            <RadzenDataGridColumn TItem="FiscalPeriodDto" Property="MonthId" Title="Period"
                                                                  Filterable="false" Width="20px" />
                                            <RadzenDataGridColumn TItem="FiscalPeriodDto" Property="MonthName" Title="Month"
                                                                  Filterable="false" Width="100px" />
                                            <RadzenDataGridColumn TItem="FiscalPeriodDto" Property="StartDate" Title="Start"
                                                                  Filterable="false" Width="100px" FormatString="{0:d}" />
                                            <RadzenDataGridColumn TItem="FiscalPeriodDto" Property="EndDate" Title="End"
                                                                  Filterable="false" Width="100px" FormatString="{0:d}" />
                                            <RadzenDataGridColumn TItem="FiscalPeriodDto" Property="PeriodClosed" Title="Period Closed?"
                                                                  Filterable="false" Width="100px" />
                                        </Columns>
                                    </RadzenDataGrid>
                                </ChildContent>
                                <ErrorContent Context="ex">
                                    <!-- Fallback UI when an error occurs -->
                                    <p class="errorUI">An error has occurred: @ex.Message</p>
                                </ErrorContent>
                            </ErrorBoundary>
                        }
                    </div>
                </div>
            </div>
        </RadzenCard>               
    </ChildContent>
    <ErrorContent Context="ex">
        <p class="errorUI">An error has occurred: @ex.Message</p>
    </ErrorContent>
</ErrorBoundary>