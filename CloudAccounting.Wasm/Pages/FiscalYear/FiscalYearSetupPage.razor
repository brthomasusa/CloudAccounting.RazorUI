@page "/Pages/FiscalYear/FiscalYearSetupPage"
@using CloudAccounting.Wasm.Components


<PageTitle>Fiscal Year Setup</PageTitle>

<RadzenText TextStyle="TextStyle.Subtitle1">Manage Company Fiscal Year Information</RadzenText>

<ErrorBoundary>
    <ChildContent>
        <RadzenCard Variant="Variant.Text" class="rz-p-0 rz-m-0">
            <RadzenTemplateForm TItem="CreateFiscalYearCommand" Data="@_fiscalYearCommand" Submit="@(async ( args) => { await Submit(args); })">
                <RadzenRow Gap="2rem" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" class="rz-p-0 rz-p-lg-4">
                    <RadzenColumn Size="4">
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                            <RadzenLabel class="rz-m-0" TextStyle="TextStyle.Subtitle2" Style="width: 150px;" Component="fiscalYearInput">
                                <span style="color: red;">*</span> Fiscal Year
                            </RadzenLabel>
                            <RadzenNumeric Name="fiscalYearInput"
                                            @bind-Value=@_fiscalYearCommand.FiscalYear
                                            Placeholder="Enter fiscal year" />
                            <RadzenCustomValidator 
                                Component="fiscalYearInput" 
                                                    Validator="@(() => ValidateFiscalYear(_fiscalYearCommand.FiscalYear))"
                                Text="Fiscal year must be greater than any previous fiscal year." 
                                Popup="true" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                            <RadzenLabel Style="width: 150px;" Component="startDate">
                                <span style="color: red;">*</span> Start Date
                            </RadzenLabel>
                            <RadzenDatePicker @bind-Value=@_fiscalYearCommand.StartDate Name="startDate" ShowCalendarWeek />
                            <RadzenCustomValidator Component="startDate"
                                                    Validator="@(() => ValidateStartDate(_fiscalYearCommand.StartDate))"
                                                    Text="Start date must be greater than the end date of the last fiscal year."
                                                    Popup="true" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="4" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenButton 
                                ButtonType="ButtonType.Submit" 
                                ButtonStyle="ButtonStyle.Success" 
                                Size="ButtonSize.Medium" 
                                Icon="save"
                                Disabled="@_disableGenerateFiscalYearButton"
                                Text="Generate Fiscal Year" />
                        </RadzenStack>
                    </RadzenColumn>                                        
                </RadzenRow>
            </RadzenTemplateForm>
        </RadzenCard>

        <RadzenCard Variant="Variant.Text" class="rz-p-0 rz-m-0 rz-mt-7">
            @if (_fiscalYearDto is not null)
            {
                <div class="container">
                    <RadzenRow Gap="2rem" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" class="rz-p-0 rz-p-lg-4">
                        <RadzenColumn Size="4">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                <RadzenLabel class="rz-m-0" Text="Fiscal Year" TextStyle="TextStyle.Subtitle2" Style="width: 150px;" Component="fiscalYearInput" />
                                <RadzenNumeric TValue="int" Name="fiscalYearInput" value=@_fiscalYearDto!.Year ReadOnly />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenCheckBox TValue="bool" value=@_fiscalYearDto!.IsInitialFiscalYear Name="isInitYearCheckBox" ReadOnly />
                                <RadzenLabel Text="Initial Year?" Component="isInitYearCheckBox" />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                             <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                            Size="ButtonSize.Medium"
                                            Icon="delete"
                                            Text="Delete Fiscal Year"
                                            Disabled="@_disableFiscalYearDeleteButton"
                                            Click="@DeleteFiscalYear" />
                            </RadzenStack>
                        </RadzenColumn>                            
                    </RadzenRow>
                    <RadzenRow Gap="2rem" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" class="rz-p-0 rz-p-lg-4">
                        <RadzenColumn Size="12">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                @if (_fiscalYearDto is null)
                                {
                                    <LoadingIndicator />
                                }
                                else
                                {
                                    <ErrorBoundary>
                                        <ChildContent>
                                            <RadzenDataGrid TItem="FiscalPeriodDto"
                                                            Data="@(_fiscalYearDto.FiscalPeriods)"
                                                            IsLoading="@_isLoading"
                                                            LoadData="@GetFiscalPeriods"
                                                            Count="@(_fiscalYearDto.FiscalPeriods.Count)"
                                                            Density="Density.Compact"
                                                            AllowAlternatingRows="true">
                                                        
                                                <Columns>
                                                    <RadzenDataGridColumn TItem="FiscalPeriodDto" Property="MonthId" Title="Period"
                                                                        Filterable="false" Width="20px" />
                                                    <RadzenDataGridColumn TItem="FiscalPeriodDto" Property="MonthName" Title="Month"
                                                                        Filterable="false" Width="100px" />
                                                    <RadzenDataGridColumn TItem="FiscalPeriodDto" Property="StartDate" Title="Start"
                                                                        Filterable="false" Width="100px" FormatString="{0:d}" />
                                                    <RadzenDataGridColumn TItem="FiscalPeriodDto" Property="EndDate" Title="End"
                                                                        Filterable="false" Width="100px" FormatString="{0:d}" />
                                                    <RadzenDataGridColumn TItem="FiscalPeriodDto" Property="PeriodClosed" Title="Period Closed?"
                                                                        Filterable="false" Width="100px">
                                                        <Template Context="data">
                                                            @(data.PeriodClosed ? "Yes" : "No")
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                </Columns>
                                            </RadzenDataGrid>
                                        </ChildContent>
                                        <ErrorContent Context="ex">
                                            <!-- Fallback UI when an error occurs -->
                                            <p class="errorUI">An error has occurred: @ex.Message</p>
                                        </ErrorContent>
                                    </ErrorBoundary>
                                }
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </div>
            }           
        </RadzenCard>
        <RadzenAlert 
            Visible="@_showErrorAlert" 
            Title="@_errorAlertTitle"
            AlertStyle="AlertStyle.Danger" 
            Variant="Variant.Flat" 
            Shade="Shade.Lighter" 
            AllowClose="true" 
            Close="@OnAlertClose">
            @_errorAlertMessage
        </RadzenAlert>
    </ChildContent>
    <ErrorContent Context="ex">
        <p class="errorUI">An error has occurred: @ex.Message</p>
    </ErrorContent>
</ErrorBoundary>