@page "/login"

@using CloudAccounting.Wasm.Authentication
@using CloudAccounting.Wasm.Services.ApplicationState
@using CloudAccounting.Wasm.Services.Repositories.Authentication
@using CloudAccounting.Wasm.Models.Authentication

@inject NavigationManager Navigation
@inject IAuthenticationService AuthenticationService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Login</PageTitle>

<div class="rz-text-align-center rz-mt-12">
    <RadzenText TextStyle="TextStyle.Subtitle1">Login</RadzenText>
</div>

<ErrorBoundary>
    <ChildContent>
        <RadzenCard Variant="Variant.Outlined" class="rz-my-12 rz-mx-auto" Style="max-width: 420px">
            <RadzenTemplateForm TItem="LoginCommand" Data=@user Submit=@OnSubmit>
                <RadzenStack Gap="1rem">
                    <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                        <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                            <RadzenLabel Text="Email" Component="email" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenTextBox Name="email" @bind-Value=@user.Email Style="display: block; width: 100%;" />
                            <RadzenRequiredValidator Component="email" Text="An email address is required." Style="position: absolute" />
                            <RadzenEmailValidator Component="email" Text="Provide a valid email address" Style="position: absolute" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                        <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                            <RadzenLabel Text="Password" Component="password" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenPassword Name="password" @bind-Value=@user.Password Style="display: block; width: 100%;" />
                            <RadzenRequiredValidator Component="password" Text="A password is required." Style="position: absolute" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12" class="rz-text-align-end">
                            <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Medium" Icon="login" Text="Login" />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>

        <RadzenAlert Visible="@_showErrorAlert"
                     Title="@_errorAlertTitle"
                     AlertStyle="AlertStyle.Danger"
                     Variant="Variant.Flat"
                     Shade="Shade.Lighter"
                     AllowClose="true"
                     Close="@OnAlertClose">
            @_errorAlertMessage
        </RadzenAlert>
    </ChildContent>
    <ErrorContent Context="ex">
        <p class="errorUI">An error has occurred: @ex.Message</p>
    </ErrorContent>
</ErrorBoundary>

@code {
    private LoginCommand user = new LoginCommand();
    private bool _showErrorAlert = false;
    private string _errorAlertMessage = string.Empty;
    private string _errorAlertTitle = string.Empty;
    [Inject] private IAuthenticatedUserState? AuthenticatedUserState { get; set; }

    private async Task OnSubmit(LoginCommand args)
    {
        Result<LoginResponseModel> result = await AuthenticationService.LoginAsync(args);

        if (result.IsSuccess)
        {
            await ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsAuthenticated(result.Value);

            Result<ApplicationUser> userResult = await AuthenticationService.GetUserByIdAsync(user.Email);

            if (userResult.IsSuccess)
            {
                AuthenticatedUserState!.SetUser(userResult.Value);
            }

            Navigation.NavigateTo("/");
        }
        else
        {
            _errorAlertTitle = "Log in failed!";
            _errorAlertMessage = result.Error.Message;
            _showErrorAlert = true;
        }
    }

    private void OnAlertClose()
    {
        _showErrorAlert = false;
        _errorAlertMessage = string.Empty;
        _errorAlertTitle = string.Empty;
    }
}