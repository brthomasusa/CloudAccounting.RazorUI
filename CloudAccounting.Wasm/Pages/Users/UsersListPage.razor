
@page "/Pages/Users/UsersListPage"
@using CloudAccounting.Wasm.Models.Authentication

<PageTitle>Users & Roles</PageTitle>

<RadzenText TextStyle="TextStyle.Subtitle1">Manage Users and Roles</RadzenText>

<ErrorBoundary>
    <ChildContent>
        <RadzenRow class="rz-mt-5">
            <RadzenColumn Size="4">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    <RadzenLabel class="rz-m-0" TextStyle="TextStyle.Subtitle2">Roles</RadzenLabel>
                    <RadzenCard Variant="Variant.Outlined" class="rz-p-0 rz-m-0">
                        <RadzenTree Data=@_roles Expand=@OnExpand Change=@OnChange Style="width: 100%; height: 300px">
                            <RadzenTreeLevel TextProperty="@nameof(RoleModel.GroupTitle)" />
                        </RadzenTree>
                    </RadzenCard>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="8">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    <RadzenLabel class="rz-m-0" TextStyle="TextStyle.Subtitle2">Users in Selected Role</RadzenLabel>
                    <RadzenCard Variant="Variant.Outlined" class="rz-p-0 rz-m-0">
                        @if (_selectedCompanyCode > 0)
                        {
                            <p class="rz-p-3">Select a group to view its users.</p>
                        }
                        else
                        {
                            <p class="rz-p-3">No group selected.</p>
                        }
                    </RadzenCard>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenAlert Visible="@_showErrorAlert" Title="@_errorAlertTitle" AlertStyle="AlertStyle.Danger"
                     Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="true" Close="@OnAlertClose">
            @_errorAlertMessage
        </RadzenAlert>
    </ChildContent>
    <ErrorContent Context="ex">
        <p class="errorUI">An error has occurred: @ex.Message</p>
    </ErrorContent>
</ErrorBoundary>
